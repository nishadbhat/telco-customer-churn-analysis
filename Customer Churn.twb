      <column datatype='integer' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM([Calculation_2359323292429787139])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Tenure Group' datatype='string' name='[Calculation_2359323292383481856]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Tenure Months] &lt;=6 THEN &apos;0-6 Months&apos;&#13;&#10;ELSEIF  [Tenure Months] &gt;6 AND  [Tenure Months] &lt;=12 THEN &apos;6-12 Months&apos;&#13;&#10;ELSEIF  [Tenure Months] &gt; 12 AND  [Tenure Months] &lt;=24 THEN &apos;12-24 Months&apos;&#13;&#10;ELSE &apos;24+ Months&apos;&#13;&#10;END' />
      </column>
      <column caption='Churn Rate' datatype='real' default-format='p0.00%' name='[Calculation_2359323292385460225]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='SUM(IF  [Churn]=&apos;Yes&apos; THEN 1 ELSE 0 END )/ COUNT([CustomerID])' />
      </column>
      <column caption='Revenue Lost' datatype='real' name='[Calculation_2359323292403519490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Churn]=&apos;Yes&apos; THEN [Monthly Charges] &#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Total Churned Customers' datatype='integer' name='[Calculation_2359323292429787139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF [Churn]=&apos;Yes&apos; THEN 1 ELSE 0 END)' />
      </column>
